{
  "manifest_version": 3,
  "name": "ff-mcp",
  "version": "0.1.1",
  "description": "Capability-gated access to Firefox for local MCP clients.",
  "icons": {
    "32": "icons/ff-mcp-32.png",
    "48": "icons/ff-mcp-48.png",
    "96": "icons/ff-mcp-96.png",
    "128": "icons/ff-mcp-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ff-mcp@local",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      },
      "strict_min_version": "150.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/policy.js",
      "shared/rule-model.js",
      "background.js"
    ],
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/ff-mcp-16.png",
      "32": "icons/ff-mcp-32.png",
      "64": "icons/ff-mcp-64.png"
    },
    "default_title": "ff-mcp",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
